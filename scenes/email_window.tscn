[sub_resource type="GDScript" id="GDScript_soi6o"]
script/source = "extends Node2D



func _ready() -> void:
	pass 

func _input(event):
	var content = event.as_text()
	var number_safe = \"\"
	if content and event.is_pressed():
		if content == \"Enter\":
			$Email_text.text += \"\\n\"
			number_safe = \"\\n\"
		if not content.length() > 1:
			$Email_text.text += event.as_text()
			number_safe = event.as_text()
		if content == \"Backspace\":
			$Email_text.text.left(-1)
			number_safe = \"\"
	
	if number_safe in TheGlobe.keys_to_press:
		TheGlobe.keys_to_press.erase(number_safe)


func clear_text():
	$Email_text.clear_text()


func _on_close_window_button_pressed() -> void:
	self.hide()
"

